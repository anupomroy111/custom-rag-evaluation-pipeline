GEMINI_API_KEY=your_api_key_here
# Optional overrides
# NOTE: older gemini-2.5-flash free tier allows only 20 requests/day and is
# closed to new users; flash-lite models have a much larger daily quota.
RAG_LLM_MODEL=gemini-3.5-flash-lite
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIM=768
RAG_RPM=10
RAG_EMBED_RPM=100
RAG_LLM_CACHE=1